-- Store Procedure
CREATE OR ALTER PROCEDURE ADD_Return_records
    @p_return_id VARCHAR(50),
    @p_issued_id VARCHAR(50),
    @p_return_book_name VARCHAR(50),
    @p_return_date date,
    @p_return_book_isbn VARCHAR(50),
    @p_book_quality VARCHAR(50)
AS
BEGIN

    -- Inserting into Return_Status based on user's input
    INSERT INTO Return_Status
    (
        return_id,
        issued_id,
        return_book_name,
        return_date,
        return_book_isbn,
        book_quality
    )
    VALUES
    (
        @p_return_id,
        @p_issued_id,
        @p_return_book_name,
        @p_return_date,
        @p_return_book_isbn,
        @p_book_quality
    );

    -- Getting ISBN and Book name for the update
    DECLARE @v_isbn VARCHAR(50);
    DECLARE @v_book VARCHAR(50);

    SELECT
        @v_isbn = issued_book_isbn,
        @v_book = issued_book_name
    FROM Issued_Stauts
    WHERE issued_id = @p_issued_id;

    -- Updating book status
    UPDATE Books
    SET status = 'yes'
    WHERE isbn = @v_isbn;

    -- Message
    PRINT 'Thank you for returning the Book: ' + @v_book;

END;

