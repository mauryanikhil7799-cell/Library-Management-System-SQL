--- Task-1 Identify Members with overdue Books---
--- write a query to identify members who have overdue(Assume 30 days return period)---
---Display the Members_id,Member's name, book title,Issue_Date,book title---
SELECT 
i.issued_member_id,
m.member_name,
i.issued_book_name,
r.return_date,
i.issued_date,
DATEDIFF(DAY,i.issued_date,GETDATE()) AS Overdue_days,
CASE 
    WHEN r.return_date IS NULL AND 
    DATEADD(DAY,30, i.issued_date)<GETDATE()
    THEN 'Overdue'
    ELSE 'Retrun'
End AS Status,
DATEDIFF(DAY,i.issued_date,GETDATE())*2 AS Fine
FROM Issued_Stauts AS i
LEFT JOIN Return_Status AS r
ON i.issued_id=r.issued_id
LEFT JOIN Members AS m
ON i.issued_member_id=m.member_id
WHERE r.return_date IS NULL and DATEDIFF(DAY,i.issued_date,GETDATE())>30

